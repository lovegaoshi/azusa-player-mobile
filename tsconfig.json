{
  "extends": "@tsconfig/react-native/tsconfig.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "module": "esnext",
    "ignoreDeprecations": "6.0",
    "paths": {
      "react-native-bottom-tabs/lib/*": [
        "./node_modules/react-native-bottom-tabs/lib/*"
      ],
      "@react-navigation/drawer/lib/*": [
        "./node_modules/@react-navigation/drawer/lib/*"
      ],
      "youtubei.js/dist/src/*": ["./node_modules/youtubei.js/dist/src/*"],
      "@/*": ["./src/*"],
      "*": ["./src/*"],
      "@components/*": ["./src/components/*"],
      "@types/*": ["./src/types/*"],
      "@utils/*": ["./src/utils/*"],
      "@specs/*": ["./specs/*"],
      "@contexts/*": ["./src/contexts/*"],
      "@assets/*": ["./src/assets/*"],
      "@enums/*": ["./src/enums/*"],
      "@objects/*": ["./src/objects/*"],
      "@services/*": ["./src/services/*"],
      "@stores/*": ["./src/stores/*"],
      "@hooks/*": ["./src/hooks/*"],
      // this compiles so im letting it slide
      // https://www.typescriptlang.org/docs/handbook/modules/reference.html#paths-should-not-point-to-monorepo-packages-or-node_modules-packages
      "@expo/ui/community/slider": [
        "./node_modules/@expo/ui/build/community/slider/index.d.ts"
      ],
      "@expo/ui/community/slider/*": [
        "./node_modules/@expo/ui/build/community/slider/*"
      ],
      "@expo/ui": ["./node_modules/@expo/ui/build/universal/index.d.ts"],
      "@expo/ui/*": ["./node_modules/@expo/ui/build/universal/*"]
    },
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "jsx": "react-native",
    "lib": ["ESNext"],
    "outDir": "./lib",
    "strict": true,
    "target": "ESNext",
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "**/__tests__/*", "MusicFreePlugins"]
}
